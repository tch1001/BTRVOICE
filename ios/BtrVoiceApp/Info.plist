	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tanchienhao.BtrVoice.listen</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>btrvoice</string>
			</array>
		</dict>
	</array>
